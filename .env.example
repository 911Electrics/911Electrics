# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Supabase). In serverless use the Supavisor *transaction pooler*
# (port 6543) — the direct connection exhausts its connection limit.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Signs the Studio admin session cookie and encrypts stored OAuth tokens
# (src/lib/secret-box.ts). Historical name — it predates the Payload removal.
# Rotating it signs every admin out and invalidates stored Google tokens.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Canonical origin, no trailing slash. Drives canonical URLs, the sitemap, and
# the noindex header on any non-canonical host.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Authorizes the Vercel cron endpoints (/api/cron/tick, /api/cron/follow-ups).
# Required: without it those endpoints answer 503 and scheduled posts and
# follow-up reminders stop. Vercel sends it automatically on cron invocations.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Media uploads (Studio image library + API hero images) → Supabase Storage
# `media` bucket. The service_role key is server-only; never expose it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─────────────────────────────────────────────────────────────────────────────
# Lead notifications — required in production
# ─────────────────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY a lead is still saved to the database, but nobody is
# emailed about it. The from-address domain must be verified in Resend.
RESEND_API_KEY=YOUR_RESEND_API_KEY
LEAD_FROM_EMAIL=leads@example.com
# Overrides the Site Settings email as the notification recipient.
LEAD_NOTIFICATION_EMAIL=owner@example.com

# ─────────────────────────────────────────────────────────────────────────────
# Programmatic API
# ─────────────────────────────────────────────────────────────────────────────
# The admin API lives at /api/admin/v1 (GET it with any key for a self-describing
# index). Access is granted with keys created in Studio → API keys: each has a
# name, a set of scopes and an optional expiry, is revocable instantly, and is
# named in the audit log. That needs the `api_keys` table — apply
# db/migrations/20260918_api_keys.sql once.
#
# The two variables below are the ORIGINAL env-var tokens. They still work, as
# fixed-scope legacy keys, so nothing breaks on deploy — but they cannot be
# scoped per consumer or revoked without a redeploy. Move each integration to a
# Studio key, then delete these.
#
# BLOG_API_TOKEN — content only: posts, service areas, services, reviews, cache.
# It is the token the external blog writer holds, so treat it as semi-trusted.
# Old URLs (/api/blog/*, /api/content/*, /api/leads, /api/revalidate) remain as
# aliases of /api/admin/v1/*.
BLOG_API_TOKEN=YOUR_BLOG_API_TOKEN
# LEADS_API_TOKEN — read-only lead export (customer names, phones, emails,
# addresses). While this is UNSET, BLOG_API_TOKEN can also export leads (the
# original behaviour). Set it — or better, use a Studio key with `leads:read` —
# and keep it out of the blog writer's configuration.
#LEADS_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — analytics
# ─────────────────────────────────────────────────────────────────────────────
# Client-side page/event capture.
#NEXT_PUBLIC_POSTHOG_KEY=
#NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side reads for the Studio analytics dashboard (a personal API key).
#POSTHOG_API_KEY=
#POSTHOG_HOST=https://us.posthog.com
#POSTHOG_PROJECT_ID=
# GA4 — also enables phone-click conversion tracking.
#NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — error monitoring
# ─────────────────────────────────────────────────────────────────────────────
# The DSN is public and baked in as a fallback, so monitoring works out of the
# box. Override here if it is ever rotated.
#NEXT_PUBLIC_SENTRY_DSN=
# Secret — only needed so the Vercel build can upload source maps and
# de-minify stack traces. Builds succeed without it. Scope: project:releases.
#SENTRY_AUTH_TOKEN=
#SENTRY_ORG=
#SENTRY_PROJECT=
#SENTRY_HOST=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — lead-form bot challenge (on top of the built-in honeypot +
# time-trap). If the secret is unset, Turnstile is skipped entirely.
# ─────────────────────────────────────────────────────────────────────────────
#TURNSTILE_SECRET_KEY=
#NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — SMS alert to the owner on a new lead
# ─────────────────────────────────────────────────────────────────────────────
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM_NUMBER=
# Defaults to the Site Settings phone number.
#LEAD_SMS_TO=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — Google Business Profile (review sync in Studio → Reviews)
# ─────────────────────────────────────────────────────────────────────────────
# OAuth client from Google Cloud; the redirect URI is
# {NEXT_PUBLIC_SERVER_URL}/api/google/callback.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — escape hatch
# ─────────────────────────────────────────────────────────────────────────────
# Overrides the canonical hostname used for the noindex-non-canonical check.
# Only needed if the canonical domain differs from NEXT_PUBLIC_SERVER_URL.
#CANONICAL_DOMAIN=
